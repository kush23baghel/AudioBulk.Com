# Copy this file to .env and fill in your values
#
# NOTE: There is deliberately no VITE_OPENROUTER_API_KEY here. Vite inlines every
# VITE_* value into the public JS bundle, so an API key set this way is readable by
# anyone who loads the site. AudioBulk is bring-your-own-key: users paste their own
# OpenRouter key into the in-app Settings panel and it stays in their localStorage.
# Get a free key at https://openrouter.ai

VITE_OPENROUTER_MODEL="meta-llama/llama-3-8b-instruct:free"
